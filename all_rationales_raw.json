      "voter": "π Lanningham",
      "content": "<!-- url: https://www.314pool.com/votes/8845bfc37bb2f69e8f200fe28148b3dea3c4399b0c49ee0ed2bb4e349cab9eb700.jsonld -->\r\n# π Lanningham\r\n\r\n**Proposal:** Name Protocol Version 11 hard fork - van Rossem\r\n**Vote:** Yes\r\n**Voter ID:** `drep1y2sld9e4nmasqfpusd5e67rwczj4l20d3653jgs38r4mams52y4jx`\r\n\r\n---\r\n\r\n{\r\n  \"@context\": {\r\n    \"CIP100\": \"https://github.com/cardano-foundation/CIPs/blob/master/CIP-0100/README.md#\",\r\n    \"hashAlgorithm\": \"CIP100:hashAlgorithm\",\r\n    \"body\": {\r\n      \"@id\": \"CIP100:body\",\r\n      \"@context\": {\r\n        \"references\": {\r\n          \"@id\": \"CIP100:references\",\r\n          \"@container\": \"@set\",\r\n          \"@context\": {\r\n            \"GovernanceMetadata\": \"CIP100:GovernanceMetadataReference\",\r\n            \"Other\": \"CIP100:OtherReference\",\r\n            \"label\": \"CIP100:reference-label\",\r\n            \"uri\": \"CIP100:reference-uri\"\r\n          }\r\n        },\r\n        \"comment\": \"CIP100:comment\",\r\n        \"externalUpdates\": {\r\n          \"@id\": \"CIP100:externalUpdates\",\r\n          \"@context\": {\r\n            \"title\": \"CIP100:update-title\",\r\n            \"uri\": \"CIP100:uri\"\r\n          }\r\n        }\r\n      }\r\n    }\r\n  },\r\n  \"body\": {\r\n    \"comment\": \"I am voting YES on governance action 8845bfc37bb2f69e8f200fe28148b3dea3c4399b0c49ee0ed2bb4e349cab9eb7, which names the hardfork introducing Protocol Version 11 the \"van Rossem Hard Fork\". This continues the tradition of naming Hard Forks after impactful members of the Cardano community who have sadly passed away. Max van Rossem's impact on the Cardano community was clear and undeniable.\\n\\n You can find a larger writeup of my beliefs and values [here](https://314pool.com/posts/constitution-vote-1).\",\r\n    \"references\": [\r\n        {\r\n            \"label\": \"Values\",\r\n            \"uri\": \"https://314pool.com/post/constitution-vote-1\"\r\n