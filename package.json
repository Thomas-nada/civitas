{
  "name": "drep-accountability-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Civitas: Cardano governance intelligence, indexed from Koios.",
  "scripts": {
    "start": "node server.js",
    "build": "npm --prefix frontend run build",
    "dev:frontend": "npm --prefix frontend run dev",
    "lint": "npm --prefix frontend run lint",
    "test": "node scripts/smoke-check.mjs",
    "test:cip179": "node --test test/cip179.test.mjs",
    "test:e2e": "playwright test",
    "ci": "npm run lint && npm run build && npm run test:unit && npm run test:sync && npm run test:api && npm run test",
    "test:sync": "node --test test/sync.test.mjs",
    "test:unit": "node --test test/cip179.test.mjs test/surveys.test.mjs",
    "test:api": "node --test test/apiV1.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.2"
  },
  "dependencies": {
    "@evolution-sdk/evolution": "^0.5.9",
    "cardano-tessera-client": "^0.3.0",
    "cip-179": "^0.5.0"
  }
}
