# ── Data sources ─────────────────────────────────────────────────────────────
# Governance data is indexed from Koios. The public tier allows ~5,000
# requests/day; a free Koios account key raises that to 50,000/day. A full
# rebuild costs a few hundred requests and a delta sync a handful.
KOIOS_BASE_URL=https://api.koios.rest/api/v1
KOIOS_API_KEY=
KOIOS_MAX_RETRIES=4
KOIOS_REQUEST_TIMEOUT_MS=15000
KOIOS_REQUEST_DELAY_MS=120
# Per-proposal voting summaries: "pending" (only open actions, cheapest) or "all".
KOIOS_VOTING_SUMMARY_SCOPE=pending
# Voting-power model behind every percentage: "local" (the snapshot's own DRep
# and pool power, as the production site shows) or "koios" (the stored Koios
# proposal_voting_summary applied on top).
VOTING_MODEL=local

# Blockfrost is optional: an IPFS gateway for metadata and a fallback source.
# BLOCKFROST_DAILY_BUDGET caps how many Blockfrost requests a day the server
# may spend (0 disables Blockfrost entirely).
BLOCKFROST_API_KEY=
BLOCKFROST_BASE_URL=https://cardano-mainnet.blockfrost.io/api/v0
BLOCKFROST_DAILY_BUDGET=5000
BLOCKFROST_MAX_RETRIES=3
BLOCKFROST_REQUEST_TIMEOUT_MS=8000
BLOCKFROST_REQUEST_DELAY_MS=120

# CIP-179 surveys are read from a Tessera backend (the reference CIP-179 indexer),
# mainnet by default. The app URL is used for "Open on Tessera" links.
TESSERA_BACKEND_URL=https://tessera-backend-mainnet.matthieu-pizenberg.workers.dev
TESSERA_APP_URL=https://tessera-mainnet.matthieu-pizenberg.workers.dev

# ── HTTP ─────────────────────────────────────────────────────────────────────
PORT=8080
HOST=127.0.0.1
# Used for sitemap.xml, robots.txt and server-side SEO meta injection (the www
# host is the one the apex redirects to).
CANONICAL_URL=https://www.civitasexplorer.com

# ── Sync schedule ────────────────────────────────────────────────────────────
# Delta syncs (new votes and proposals, watermark-based) run every DELTA_POLL_MS;
# a full rebuild runs at the scheduled UTC hours and at most once per
# FULL_REBUILD_INTERVAL_MS. DELTA_VOTE_OVERLAP_SECONDS re-reads that much of
# the recent vote history on each delta so late-arriving rows are never missed.
SYNC_STARTUP_DELAY_MS=3000
SYNC_START_UTC_HOURS=11,23
SNAPSHOT_EXPOSE_UTC_HOURS=0,12
DELTA_POLL_MS=600000
DELTA_VOTE_OVERLAP_SECONDS=7200
SYNC_BATCH_SIZE=5
SYNC_CONCURRENCY=1
PROPOSAL_SCAN_LIMIT=0
DREP_LIMIT=0
VOTE_TX_TIME_MAX_LOOKUPS=200
# External anchor lookups (DRep profiles, proposal metadata, cgov rationale
# lookups) run this many at a time during a rebuild.
DREP_META_CONCURRENCY=8
PROPOSAL_PREFETCH_CONCURRENCY=6

# ── Storage ──────────────────────────────────────────────────────────────────
SNAPSHOT_PATH=./snapshot.accountability.json
SNAPSHOT_HISTORY_DIR=./snapshot_history
VOTE_TX_TIME_CACHE_PATH=./cache.voteTxTimes.json

# ── Optional integrations ────────────────────────────────────────────────────
# Guardrails script reference presets by network for auto-fill in the submit UI:
# GUARDRAILS_REFERENCE_PRESETS_JSON={"mainnet":{"txHash":"<tx>","txIndex":0,"scriptSize":"12345","scriptHash":"<56hex>","version":"V3"}}
GUARDRAILS_REFERENCE_PRESETS_JSON=
# Raises the GitHub API limit for the CIP library and the rationales archive.
GITHUB_TOKEN=

# ── Admin endpoints and rate limits ──────────────────────────────────────────
BUG_REPORTS_TOKEN=
OPERATIONS_API_TOKEN=
BUG_REPORT_RATE_LIMIT_MAX=6
BUG_REPORT_RATE_LIMIT_WINDOW_MS=60000
OPS_RATE_LIMIT_MAX=12
OPS_RATE_LIMIT_WINDOW_MS=60000
